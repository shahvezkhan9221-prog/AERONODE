# Supabase Dashboard > Project Settings > Database > Connection string > Transaction pooler.
# Add `?sslmode=require` if it is not already present.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Optional fallback relay only. Browser port buttons use the signed-in operator session.
GATEWAY_TOKEN=replace-with-a-long-random-secret

# Optional relay-only values (not needed for the front-page port buttons).
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200
DASHBOARD_URL=http://localhost:3000
